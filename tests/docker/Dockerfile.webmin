# Image for the Webmin stage: Webmin, the tools, and a PKI, so the
# module can be driven over HTTP exactly as a browser would.
#
# Webmin is installed from its own release rather than from a third-party
# image. Nothing on Docker Hub tracks current releases - the images there are
# years behind - and the whole point is to test against the version the target
# host runs, pinned here and in the Makefile.
#
# Ubuntu 24.04 because the distribution packages are what a target host runs.

FROM ubuntu:24.04

ARG WEBMIN_VERSION=2.653

RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      ca-certificates \
      curl \
      openvpn \
      easy-rsa \
      openssl \
      python3 \
      make \
      procps \
 && curl -sSLo /tmp/webmin.deb \
      "https://github.com/webmin/webmin/releases/download/${WEBMIN_VERSION}/webmin_${WEBMIN_VERSION}_all.deb" \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends /tmp/webmin.deb \
 && rm -f /tmp/webmin.deb \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /src
# The repository, not a list of paths. An enumerated COPY restates the tree
# and drifts from it: make, VERSION and packaging/ were each missing in turn,
# every time because the reasoning was about what the code under test needs
# rather than what the entrypoint runs. .dockerignore names what to leave out,
# which is a short list that changes rarely.
COPY . /src

# Fail at build time rather than at run time. A file the entrypoint needs but
# the image does not carry produces an error three steps into a container run,
# where it reads as a broken pipeline stage rather than a missing file.
RUN test -f /src/packaging/deb/control.in \
 && test -f /src/tools/vpn-client \
 && test -f /src/tools/vpn-server \
 && test -f /src/Makefile \
 && test -f /src/VERSION \
 && test -f /src/openvpn-server/module.info

# The tools are installed from the package, not copied into place, so this
# stage runs the layout a server actually gets: both in /usr/sbin, which is
# not where the module's default configuration points. That makes the
# module resolve the path rather than read it, which is the arrangement that
# was previously only reasoned about.
RUN mkdir -p /var/log/openvpn

# Build a server and issue a client, then run the stage against it. systemctl
# is faked for the duration: there is no init system here, and the stage is
# about the module rather than about the unit.
COPY tests/docker/webmin-entrypoint.sh /usr/local/bin/webmin-entrypoint.sh
ENTRYPOINT ["bash", "/usr/local/bin/webmin-entrypoint.sh"]
