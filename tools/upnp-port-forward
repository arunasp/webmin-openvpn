#!/bin/bash
# Manage an inbound UPnP port mapping on the router, tied to a service.
#
# Usage: upnp-port-forward {open|close|extip|status}
# Config: /etc/default/upnp-port-forward
#
# OPTIONAL. A server reachable on a static address, or one whose port is
# forwarded by hand, needs none of this. Nothing here runs unless the unit is
# enabled, and vpn-server works whether or not this exists: it updates the
# mapping's port when it finds the configuration file and says nothing when
# it does not.
#
# WHY A TIMER AS WELL AS A SERVICE: UPnP mappings are leases. A lease expires,
# and a router forgets its mappings when it reboots. `open` is therefore
# idempotent and re-asserted periodically while the VPN is up; re-adding an
# identical mapping is harmless.
#
# SAFETY: `open` refuses if nothing is listening on the port, and tears down
# any existing mapping for it. A forwarded port pointing at a dead service is
# worse than no mapping at all - it is an open hole nobody is watching.
#
# Requires miniupnpc (the upnpc command).
set -uo pipefail

CONF=${CONF:-/etc/default/upnp-port-forward}
# shellcheck disable=SC1090
[ -r "$CONF" ] && . "$CONF"

# The interface carrying the default route, which is the one the router is on.
# Naming an interface here would be right for one host and wrong for the next.
default_if() {
    ip -4 route show default 2>/dev/null | awk '{print $5; exit}'
}

WAN_IF=${WAN_IF:-$(default_if)}
PORT=${PORT:-1194}
PROTO=${PROTO:-UDP}
LEASE=${LEASE:-3600}
DESC=${DESC:-openvpn}
# A third-party address checker, used only if the router will not answer.
# No default: every candidate names somebody's service, and a site that wants
# one should choose it. Without it, extip reports nothing rather than
# reporting an answer from a party the operator did not pick.
CHECKIP_URL=${CHECKIP_URL:-}

log() { logger -t upnp-port-forward "$*" 2>/dev/null; echo "$*"; }

internal_ip() {
    # A seam for testing, and for a host whose address on the LAN is not the
    # one the interface reports - a bridge, or a second address on the same
    # link. The router needs the address it will forward to.
    if [ -n "${INTERNAL_IP:-}" ]; then
        printf '%s\n' "$INTERNAL_IP"
        return 0
    fi
    [ -n "$WAN_IF" ] || return 1
    ip -4 addr show "$WAN_IF" 2>/dev/null | awk '/inet /{print $2}' | cut -d/ -f1
}

listening() {
    local flag
    flag=$([ "$PROTO" = "TCP" ] && echo t || echo u)
    ss -ln"$flag" 2>/dev/null | grep -qE ":${PORT}[[:space:]]"
}

# Quoted, or null when empty. Enough for the fields here: they come from a
# router's own output and hold addresses, URLs and status words.
json_str() {
    if [ -z "${1:-}" ]; then
        printf 'null'
    else
        printf '"%s"' "$(printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g')"
    fi
}

# One call to the router, parsed once. upnpc -l answers everything a status
# view needs: whether an IGD was found at all, the external address, the WAN
# connection state, and the mapping table with its lease countdown.
#
# UPNPC_LIST exists so the parsing can be tested against captured output from
# a router. Parsing is where this breaks - routers vary in spacing and in
# which lines they emit - and a test that generates the text it then parses
# proves only that the generator and the parser agree.
router_list() {
    if [ -n "${UPNPC_LIST:-}" ]; then
        cat "$UPNPC_LIST"
    else
        timeout "${UPNPC_TIMEOUT:-8}" upnpc -m "$WAN_IF" -l 2>&1
    fi
}

# The row for the mapping this host is configured for: the lease in seconds,
# or nothing when the router is not forwarding it. Matched on external port,
# protocol, internal address and internal port together, since a router will
# happily hold a mapping for the same port pointing somewhere else.
our_lease() {
    local list=$1 ip
    ip=$(internal_ip)
    printf '%s\n' "$list" |
        awk -v proto="$PROTO" -v port="$PORT" -v ip="$ip" '
            $2 == proto {
                split($3, a, "->")
                split(a[2], b, ":")
                if (a[1] == port && b[1] == ip && b[2] == port) {
                    print $NF
                    exit
                }
            }'
}

do_open() {
    [ -n "$WAN_IF" ] || { log "no default route interface, and WAN_IF is not set"; exit 1; }
    ip=$(internal_ip)
    [ -n "$ip" ] || { log "no address on $WAN_IF"; exit 1; }
    if ! listening; then
        log "nothing listening on $PROTO/$PORT - refusing, and removing any stale mapping"
        upnpc -m "$WAN_IF" -d "$PORT" "$PROTO" >/dev/null 2>&1
        exit 1
    fi
    out=$(upnpc -m "$WAN_IF" -e "$DESC" -a "$ip" "$PORT" "$PORT" "$PROTO" "$LEASE" 2>&1)
    if echo "$out" | grep -q "is redirected to internal"; then
        ext=$(echo "$out" | sed -n 's/.*ExternalIPAddress = //p' | head -1)
        log "mapped $PROTO/$PORT -> $ip (external $ext, lease ${LEASE}s)"
    else
        log "FAILED to map $PROTO/$PORT: $(echo "$out" | tail -2 | tr '\n' ' ')"
        exit 1
    fi
}

case "${1:-}" in
open)
    do_open
    ;;
close)
    upnpc -m "$WAN_IF" -d "$PORT" "$PROTO" >/dev/null 2>&1
    log "removed mapping $PROTO/$PORT"
    ;;
extip)
    # The address as the router reports it. That beats asking a third party:
    # it is the authoritative answer, needs no round trip off the network, and
    # cannot be confused by a proxy or a CDN.
    ext=$(upnpc -m "$WAN_IF" -l 2>/dev/null | sed -n 's/.*ExternalIPAddress = //p' | head -1)
    if [ -n "$ext" ]; then
        echo "$ext"
    elif [ -n "$CHECKIP_URL" ]; then
        curl -s -m10 "$CHECKIP_URL" 2>/dev/null |
            grep -oE '[0-9]+(\.[0-9]+){3}' | head -1
    else
        exit 1
    fi
    ;;
refresh)
    # What the timer runs: check, repair if needed, and leave a record either
    # way. Calling open unconditionally would work - it is idempotent - but the
    # journal would then show a mapping being asserted every ten minutes
    # forever, and no way to tell a healthy site from one whose router forgets
    # the mapping hourly. Checking first makes a drop a logged event.
    if list=$(router_list) && lease=$(our_lease "$list") && [ -n "$lease" ]; then
        # Quiet on the happy path: this runs every few minutes, and a line
        # each time is noise that hides the lines that matter.
        [ -n "${VERBOSE:-}" ] && log "mapping present, lease ${lease}s"
        exit 0
    fi
    if ! printf '%s\n' "$list" | grep -q '^Found valid IGD'; then
        log "no IGD answering on ${WAN_IF:-unknown} - cannot check or repair the mapping"
        exit 2
    fi
    log "mapping for $PROTO/$PORT is gone from the router - re-asserting"
    do_open
    ;;
status)
    list=$(router_list)
    igd=$(printf '%s\n' "$list" | sed -n 's/^Found valid IGD : *//p' | head -1)
    ext=$(printf '%s\n' "$list" | sed -n 's/^ExternalIPAddress = *//p' | head -1)
    state=$(printf '%s\n' "$list" | sed -n 's/^Status : *\([A-Za-z]*\).*/\1/p' | head -1)
    uptime=$(printf '%s\n' "$list" | sed -n 's/^Status :.*uptime=\([0-9]*\)s.*/\1/p' | head -1)
    lasterr=$(printf '%s\n' "$list" | sed -n 's/^Status :.*LastConnectionError : *//p' | head -1)
    lease=$(our_lease "$list")
    ip=$(internal_ip)
    listening_now=no
    listening && listening_now=yes

    if [ "${2:-}" = --json ]; then
        printf '{"port":%s,"proto":"%s","internal":"%s","listening":%s,' \
            "$PORT" "$PROTO" "$ip" \
            "$([ "$listening_now" = yes ] && echo true || echo false)"
        printf '"igd":%s,"external":%s,"state":%s,"uptime":%s,"last_error":%s,' \
            "$(json_str "$igd")" "$(json_str "$ext")" "$(json_str "$state")" \
            "${uptime:-null}" "$(json_str "$lasterr")"
        printf '"mapping":%s,"lease":%s}\n' \
            "$([ -n "$lease" ] && echo true || echo false)" "${lease:-null}"
    else
        echo "  configured: $PROTO/$PORT -> $ip via ${WAN_IF:-none}, lease ${LEASE}s"
        echo "  listening:  $listening_now"
        echo "  router:     ${igd:-none found}"
        echo "  external:   ${ext:-unknown}"
        echo "  wan:        ${state:-unknown}${uptime:+, up ${uptime}s}${lasterr:+, last error $lasterr}"
        echo "  mappings:"
        printf '%s\n' "$list" | grep -E "^ *[0-9]+ (UDP|TCP)" | sed 's/^/    /' || true
    fi

    # A mapping is a lease. A router that reboots, or is handed a new address
    # by the ISP, forgets every one it had - while the service that asked for
    # it stays active, because it succeeded once. Exiting non-zero is what
    # lets a check notice, rather than leaving it to whoever tries to connect.
    if [ -z "$igd" ]; then
        echo "  no IGD found: the router is not answering UPnP" >&2
        exit 2
    fi
    if [ -z "$lease" ]; then
        echo "  MISSING: the router is not forwarding $PROTO/$PORT to $ip" >&2
        exit 1
    fi
    ;;
*)
    echo "usage: $0 {open|close|refresh|extip|status [--json]}" >&2
    exit 2
    ;;
esac
